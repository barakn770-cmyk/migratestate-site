{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python scripts/*)",
      "Bash(python -m py_compile *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*)",
      "Bash(rm -rf *)"
    ]
  }
}
